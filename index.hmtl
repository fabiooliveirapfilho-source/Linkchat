
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LinkChat</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#101522;color:#f4f6fb;font-family:Arial,sans-serif;min-height:100vh;display:flex;justify-content:center;padding:20px}
main{width:100%;max-width:520px}
h1{color:#72a7ff;text-align:center}
.panel{background:#1b2435;padding:18px;border-radius:15px;margin:15px 0}
input,button{width:100%;padding:13px;border-radius:9px;border:0;margin:6px 0;font-size:16px}
input{background:#303b50;color:white}
button{background:#3979e8;color:white;font-weight:bold;cursor:pointer}
button.secondary{background:#354258}
#messages{height:48vh;overflow:auto;background:#121a29;padding:12px;border-radius:10px}
.msg{background:#29364d;padding:10px;border-radius:10px;margin:8px 0;overflow-wrap:anywhere}
.msg small{color:#9bb8e8;display:block;margin-top:5px}
#status{color:#a9bad5;text-align:center}
.hidden{display:none}
</style>
</head>
<body>
<main>
<h1>LinkChat 💬</h1>
<p id="status">Conectando...</p>

<section id="home" class="panel">
<input id="nickname" maxlength="30" placeholder="Seu apelido">
<button id="create">Criar conversa</button>
<hr>
<input id="roomCode" placeholder="Cole o link ou código da conversa">
<button id="join" class="secondary">Entrar em conversa</button>
</section>

<section id="chat" class="panel hidden">
<p id="roomLabel"></p>
<button id="copy" class="secondary">Copiar link da conversa</button>
<div id="messages"></div>
<input id="messageInput" maxlength="2000" placeholder="Digite sua mensagem...">
<button id="send">Enviar mensagem</button>
<button id="leave" class="secondary">Sair da conversa</button>
</section>
</main>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/13.3.0/firebase-app.js";
import { getAuth, signInAnonymously } from "https://www.gstatic.com/firebasejs/13.3.0/firebase-auth.js";
import { getDatabase, ref, set, push, onValue, query, limitToLast } from "https://www.gstatic.com/firebasejs/13.3.0/firebase-database.js";

const firebaseConfig = {
  apiKey: "AIzaSyAE356-557udsTmZZIIqnlhRSBGakYMcEg",
  authDomain: "linkchat-linkchat.firebaseapp.com",
  projectId: "linkchat-linkchat",
  storageBucket: "linkchat-linkchat.firebasestorage.app",
  messagingSenderId: "753553081256",
  appId: "1:753553081256:web:5d3d6ebc80214dc004d39d",
  databaseURL: "https://linkchat-linkchat-default-rtdb.firebaseio.com/"
};

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getDatabase(app);

const $ = id => document.getElementById(id);
let user = null;
let room = null;
let stopListening = null;

function showStatus(text){
  $("status").textContent = text;
}

function makeRoomId(){
  const bytes = crypto.getRandomValues(new Uint8Array(18));
  return Array.from(bytes,b=>b.toString(16).padStart(2,"0")).join("");
}

function getRoomFromInput(value){
  try{
    const url = new URL(value);
    return url.searchParams.get("room") || value.trim();
  }catch{
    return value.trim();
  }
}

async function enterRoom(roomId){
  if(!roomId) return alert("Informe o código da conversa.");
  room = roomId;

  try{
    await set(ref(db,`rooms/${room}/members/${user.uid}`),true);

    $("home").classList.add("hidden");
    $("chat").classList.remove("hidden");
    $("roomLabel").textContent = "Conversa: "+room;

    history.replaceState(null,"",location.pathname+"?room="+room);

    if(stopListening) stopListening();

    const messagesQuery = query(
      ref(db,`rooms/${room}/messages`),
      limitToLast(150)
    );

    stopListening = onValue(messagesQuery,snapshot=>{
      const area=$("messages");
      area.innerHTML="";

      snapshot.forEach(child=>{
        const m=child.val();
        const div=document.createElement("div");
        div.className="msg";

        const name=document.createElement("strong");
        name.textContent=m.name || "Usuário";

        const content=document.createElement("div");
        content.textContent=m.text || "";

        const date=document.createElement("small");
        date.textContent=m.createdAt
          ? new Date(m.createdAt).toLocaleString("pt-BR")
          : "";

        div.append(name,content,date);
        area.appendChild(div);
      });

      area.scrollTop=area.scrollHeight;
    },error=>{
      alert("Erro ao carregar mensagens: "+error.message);
    });

  }catch(error){
    room=null;
    alert("Não foi possível entrar: "+error.message);
  }
}

async function start(){
  try{
    const credential=await signInAnonymously(auth);
    user=credential.user;
    showStatus("Conectado!");

    const params=new URLSearchParams(location.search);
    const roomId=params.get("room");

    if(roomId){
      $("roomCode").value=roomId;
    }
  }catch(error){
    showStatus("Erro de conexão: "+error.message);
  }
}

$("create").onclick=async()=>{
  const name=$("nickname").value.trim();
  if(!name) return alert("Digite seu apelido primeiro.");
  if(!user) return alert("Aguarde a conexão com o servidor.");

  localStorage.setItem("linkchat_name",name);
  await enterRoom(makeRoomId());
};

$("join").onclick=async()=>{
  const name=$("nickname").value.trim();
  const code=getRoomFromInput($("roomCode").value);

  if(!name) return alert("Digite seu apelido primeiro.");
  if(!user) return alert("Aguarde a conexão com o servidor.");

  localStorage.setItem("linkchat_name",name);
  await enterRoom(code);
};

$("send").onclick=async()=>{
  const text=$("messageInput").value.trim();
  if(!text || !room) return;

  try{
    await push(ref(db,`rooms/${room}/messages`),{
      uid:user.uid,
      name:localStorage.getItem("linkchat_name") || "Usuário",
      text:text,
      createdAt:Date.now()
    });

    $("messageInput").value="";
  }catch(error){
    alert("Erro ao enviar: "+error.message);
  }
};

$("messageInput").addEventListener("keydown",e=>{
  if(e.key==="Enter") $("send").click();
});

$("copy").onclick=async()=>{
  try{
    await navigator.clipboard.writeText(location.href);
    alert("Link copiado!");
  }catch{
    prompt("Copie seu link:",location.href);
  }
};

$("leave").onclick=()=>{
  if(stopListening) stopListening();
  stopListening=null;
  room=null;

  $("chat").classList.add("hidden");
  $("home").classList.remove("hidden");
  history.replaceState(null,"",location.pathname);
};

start();
</script>
</body>
</html>
